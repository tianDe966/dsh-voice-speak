{
  "name": "dsh-voice-speak",
  "version": "3.1.2",
  "description": "DeepSeek Harness plugin: an agent-facing say tool that makes the agent speak one sentence out loud (local offline Xiaoxiao, Edge TTS, or Windows built-in), plus a desktop bubble and event-driven auto announcements.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "test/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tts",
    "voice",
    "speech",
    "say",
    "windows"
  ],
  "author": "tianshan123 <326958984+tianDe966@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianDe966/dsh-voice-speak.git"
  },
  "homepage": "https://github.com/tianDe966/dsh-voice-speak#readme",
  "bugs": {
    "url": "https://github.com/tianDe966/dsh-voice-speak/issues"
  }
}
