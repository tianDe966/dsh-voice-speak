{
  "name": "dsh-voice-speak",
  "version": "3.1.1",
  "description": "DeepSeek Harness plugin: an agent-facing say tool that speaks one sentence out loud (Windows System.Speech, zero dependency) plus the prompt section that decides when to speak.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tts",
    "voice"
  ],
  "license": "MIT"
}
